# Run install.sh to generate .env automatically, or copy this file and fill in your values:
#
#   cp .env.example .env

# ── Web search (Tavily) ───────────────────────────────────────────────────────
# Get a free key at https://app.tavily.com
# Injected into every agentlet container automatically — no per-agentlet setup needed.
TAVILY_API_KEY=

# ── Model credentials ─────────────────────────────────────────────────────────
# One entry per secret_name defined in platform.toml (both [chat] and [[model]]).
# Key format: PLATFORM_SECRET_<SECRET_NAME> (uppercased). Value: JSON credentials object.
#
# PLATFORM_SECRET_OPENAI={"OPENAI_API_KEY": "sk-..."}
# PLATFORM_SECRET_ANTHROPIC={"ANTHROPIC_API_KEY": "sk-ant-..."}
# PLATFORM_SECRET_AZURE_AI={"AZURE_AI_API_KEY": "...", "AZURE_AI_API_BASE": "https://..."}
# PLATFORM_SECRET_BEDROCK={"AWS_ACCESS_KEY_ID": "...", "AWS_SECRET_ACCESS_KEY": "...", "AWS_REGION_NAME": "eu-central-1"}
# PLATFORM_SECRET_GEMINI={"GEMINI_API_KEY": "..."}
# PLATFORM_SECRET_MISTRAL={"MISTRAL_API_KEY": "..."}
# PLATFORM_SECRET_OLLAMA={"OLLAMA_API_BASE": "http://localhost:11434"}

# ── Encryption key ────────────────────────────────────────────────────────────
# Generated automatically by install.sh. Never share or commit this value.
SECRET_ENCRYPTION_KEY=

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Safe defaults for local development — change before exposing outside localhost.
KEYCLOAK_DEFAULT_USER=synteles
KEYCLOAK_DEFAULT_PASSWORD=synteles
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_SECRET=synteles-dev-secret
KEYCLOAK_PROVISIONER_CLIENT_SECRET=provisioner-dev-secret

# ── Temporal ──────────────────────────────────────────────────────────────────
# Address of the Temporal frontend gRPC service. In docker-compose this resolves
# to the 'temporal' container; override when pointing at a hosted Temporal Cloud.
TEMPORAL_ADDRESS=temporal:7233
EXECUTION_BACKEND=standard
EXECUTION_RUNTIME=docker
AGENTLET_DURABLE_IMAGE=synteles/durable-agentlet:edge

# ── Agentlet image ────────────────────────────────────────────────────────────
# 'edge' tracks the latest development build. Pin to a release tag for stable
# or production deployments, e.g. synteles/agentlet:1.2.3
AGENTLET_IMAGE=synteles/agentlet:edge
