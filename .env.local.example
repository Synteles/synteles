# ── Chat engine & platform default models ────────────────────────────────────
# Configure the Synte chat model and platform default models in config/platform.toml.
# Credentials for all models (both chat and platform defaults) use the
# PLATFORM_SECRET_* pattern below — one entry per secret_name defined in platform.toml.

# ── REQUIRED: Web search (Tavily) ────────────────────────────────────────────
# Get a free key at https://app.tavily.com
# Injected into every agentlet container automatically — no per-agentlet setup needed.
TAVILY_API_KEY=

# ── Model credentials ─────────────────────────────────────────────────────────
# One entry per secret_name used in config/platform.toml (both [chat] and [[model]]).
# The key name is PLATFORM_SECRET_<SECRET_NAME> (uppercased).
# Value is a JSON object with the credentials for that provider.
#
# Examples — uncomment and fill in the ones matching your platform.toml:
#
# PLATFORM_SECRET_OPENAI={"api_key": "sk-..."}
# PLATFORM_SECRET_AZURE_AI={"api_key": "...", "api_base": "https://my-deployment.openai.azure.com"}
# PLATFORM_SECRET_ANTHROPIC={"api_key": "sk-ant-..."}
# PLATFORM_SECRET_BEDROCK={"aws_access_key_id": "...", "aws_secret_access_key": "...", "aws_region_name": "eu-central-1"}
# PLATFORM_SECRET_NEBIUS={"api_key": "..."}

# ── REQUIRED: Encryption key ──────────────────────────────────────────────────
# Run install.sh to generate this value automatically.
# Never share or commit this value.
SECRET_ENCRYPTION_KEY=

# ── Optional: Keycloak credentials ───────────────────────────────────────────
# Default user created on first run — change if you want a different login.
KEYCLOAK_DEFAULT_USER=synteles
KEYCLOAK_DEFAULT_PASSWORD=synteles

# Admin and client secrets — safe to leave as-is for local dev.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_SECRET=synteles-dev-secret
KEYCLOAK_PROVISIONER_CLIENT_SECRET=provisioner-dev-secret
