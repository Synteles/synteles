# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of the Synteles API (Traefik gateway)
API_BASE_URL=http://localhost:8080

# Keycloak realm URL
OIDC_ISSUER_URL=http://localhost:8080/auth/realms/synteles

# OIDC client credentials (must match keycloak-provisioner settings)
OIDC_CLIENT_ID=synteles-app
OIDC_CLIENT_SECRET=synteles-dev-secret

# ── Optional ──────────────────────────────────────────────────────────────────
# Integration test user — dedicated Keycloak identity for automated tests.
# Separate from the DEFAULT_USER (synteles) which is the human login account.
# Defaults match the keycloak-provisioner KEYCLOAK_TEST_USER setting.
# TEST_USER=synteles-test
# TEST_USER_PASSWORD=synteles-test

# Provisioning tests — base identity for ephemeral per-session Keycloak users.
# Each session creates a unique synteles-fresh-{uuid} user that has no DB record,
# guaranteeing the first-login provisioning path is exercised every run.
# FRESH_USER=synteles-fresh
# FRESH_USER_PASSWORD=synteles-fresh
# KEYCLOAK_PROVISIONER_CLIENT_SECRET=provisioner-dev-secret

# Agentlet model used in execution tests — defaults to a small Bedrock model
# AGENTLET_PROVIDER=bedrock
# AGENTLET_MODEL_ID=meta.llama3-2-1b-instruct-v1:0

# S3 presigned URL rewriting — needed when tests run outside Docker.
# The services generate presigned URLs using S3_INTERNAL_ENDPOINT_URL (the
# container-internal address). Set S3_PUBLIC_ENDPOINT_URL to the address
# reachable from the test host so direct presigned-URL fetches work.
# S3_INTERNAL_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
